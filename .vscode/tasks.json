{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mokxi: Push to Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli push",
      "problemMatcher": []
    },
    {
      "label": "Mokxi: Pull from Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli pull",
      "problemMatcher": []
    },
    {
      "label": "Mokxi: Run in the simulator",
      "type": "shell",
      "command": "npx --yes @mokxi/cli run --seconds 5",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Mokxi: Open in the browser",
      "type": "shell",
      "command": "npx --yes @mokxi/cli open",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Compile",
      "type": "shell",
      "command": "arduino-cli compile --fqbn arduino:avr:uno --output-dir build/IoT_Semana_5_Arduino_UNO_HC_05_y_dos_LED IoT_Semana_5_Arduino_UNO_HC_05_y_dos_LED",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Mokxi: Upload the build to Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli upload --board uno1 --firmware build/IoT_Semana_5_Arduino_UNO_HC_05_y_dos_LED/IoT_Semana_5_Arduino_UNO_HC_05_y_dos_LED.ino.elf",
      "dependsOn": "Arduino: Compile",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload to a real board",
      "type": "shell",
      "command": "arduino-cli upload --fqbn arduino:avr:uno --input-dir build/IoT_Semana_5_Arduino_UNO_HC_05_y_dos_LED --port ${input:port} IoT_Semana_5_Arduino_UNO_HC_05_y_dos_LED",
      "dependsOn": "Arduino: Compile",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Serial port of the board (arduino-cli board list shows them)",
      "default": "/dev/ttyUSB0"
    }
  ]
}
